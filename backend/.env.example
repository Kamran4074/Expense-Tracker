# =============================================
# BACKEND ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to GitHub

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<appName>

# Server port (Vercel ignores this, used for local dev only)
PORT=5000

# Frontend URL for CORS
# Local dev: http://localhost:5173
# Production: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# JWT Secret - use a long random string in production
# Generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=your_long_secure_random_jwt_secret_here
